# Copy to .env and adjust. Never commit .env.
# These values match docker-compose.yml and are for local development only.
DATABASE_URL=postgres://app:app@localhost:5432/university_assistant

# Local development only: seeds fake demo courses, resources and a demo student.
# Must never be set in production.
SEED_DEMO_DATA=true

# Used by `npm run db:seed` to create the admin account (password: 12+ characters).
# Uncomment and set locally; never commit real values.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-to-a-long-password

# Signs the 15 minute access tokens (HS256). At least 32 characters; keep it secret and
# different in every environment. Generate one with: openssl rand -base64 48
# Needed to sign in and to open /admin; the build and the public pages work without it.
AUTH_SECRET=replace-me

# File storage driver: "local" (a folder, for development and tests) or "r2" (Cloudflare R2).
# Unset means local, except on Vercel where it means r2; local is refused on Vercel.
# STORAGE_DRIVER=local
# Folder for the local driver. Default: .storage in the project root (gitignored).
# STORAGE_LOCAL_DIR=.storage

# Separate database for automated tests (name must end with _test). Created automatically.
TEST_DATABASE_URL=postgres://app:app@localhost:5432/university_assistant_test

# Running migrations against Neon (production)
# Create a SEPARATE file named .env.neon next to .env, containing exactly two lines:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
#   DATABASE_SSL=true
# Use Neon's DIRECT connection string, not the pooled one (host contains "-pooler").
# .env.neon is gitignored and must never be committed. Do not name it .env.production
# or .env.local: Next.js loads those automatically.
# Then run: npm run db:migrate:status:neon, followed by npm run db:migrate:neon
