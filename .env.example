# Copy to .env and adjust. Never commit .env.
# These values match docker-compose.yml and are for local development only.
DATABASE_URL=postgres://app:app@localhost:5432/university_assistant

# Local development only: seeds fake demo courses, resources and a demo student.
# Must never be set in production.
SEED_DEMO_DATA=true

# Used by `npm run db:seed` to create the admin account (password: 12+ characters).
# Uncomment and set locally; never commit real values.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-to-a-long-password

# Separate database for automated tests (name must end with _test). Created automatically.
TEST_DATABASE_URL=postgres://app:app@localhost:5432/university_assistant_test
