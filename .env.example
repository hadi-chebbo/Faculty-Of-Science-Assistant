# Copy to .env and adjust. Never commit .env.
# These values match docker-compose.yml and are for local development only.
DATABASE_URL=postgres://app:app@localhost:5432/university_assistant

# Local development only: seeds fake demo courses, resources and a demo student.
# Must never be set in production.
SEED_DEMO_DATA=true

# Used by `npm run db:seed` to create the admin account (password: 12+ characters).
# Uncomment and set locally; never commit real values.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-to-a-long-password

# Signs the 15 minute access tokens (HS256). At least 32 characters; keep it secret and
# different in every environment. Generate one with: openssl rand -base64 48
# Needed to sign in and to open /admin; the build and the public pages work without it.
AUTH_SECRET=replace-me

# File storage driver: "local" (a folder, for development and tests) or "r2" (Cloudflare R2).
# Unset means local, except on Vercel where it means r2; local is refused on Vercel.
# STORAGE_DRIVER=local
# Folder for the local driver. Default: .storage in the project root (gitignored).
# STORAGE_LOCAL_DIR=.storage
# Cloudflare R2, required only when STORAGE_DRIVER=r2 (all four, from the Cloudflare dashboard).
# Account ID: R2 -> Overview. Bucket: the bucket's name. Key pair: R2 -> Manage API tokens, create
# a token with permission "Object Read & Write" scoped to the one bucket.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Separate database for automated tests (name must end with _test). Created automatically.
TEST_DATABASE_URL=postgres://app:app@localhost:5432/university_assistant_test

# Running migrations against Neon (production)
# Create a SEPARATE file named .env.neon next to .env, containing exactly two lines:
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
#   DATABASE_SSL=true
# Use Neon's DIRECT connection string, not the pooled one (host contains "-pooler").
# .env.neon is gitignored and must never be committed. Do not name it .env.production
# or .env.local: Next.js loads those automatically.
# Then run: npm run db:migrate:status:neon, followed by npm run db:migrate:neon

# Error tracking (Sentry), all optional. Without the DSNs nothing is sent and nothing is needed
# (dev, tests, CI). Production sets them in Vercel, Production environment only.
# Server and edge errors: the project's DSN (Sentry -> Project settings -> Client Keys).
# SENTRY_DSN=
# Browser errors: the same DSN. NEXT_PUBLIC_ means it is visible in the browser, which is normal for a DSN.
# NEXT_PUBLIC_SENTRY_DSN=
# Source map upload at build time (token needs "Project: Releases" and "Organization: Read"); all three or none.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# Shows an "Errors" link in the admin bar that opens this page, e.g. https://ORG.sentry.io/issues/?project=ID
# SENTRY_ISSUES_URL=

# Public address of the site, used for the links in emails (no trailing slash needed). Unset: on
# Vercel https://$VERCEL_PROJECT_PRODUCTION_URL, otherwise http://localhost:3000.
# APP_URL=https://your-domain.example

# Email (queue in the email_jobs table, sent after the response; see docs/backend-architecture.md).
# Driver: "log" (dev, tests, CI) or "brevo" (production). Unset means log, except on Vercel where
# mail stays unconfigured (attempts fail and retry later); log is refused on Vercel.
# MAIL_DRIVER=log
# Log driver: append one JSON line per email to this file (tests read links from it); unset prints recipient and subject only.
# MAIL_LOG_FILE=.mail.jsonl
# Brevo, required only when MAIL_DRIVER=brevo: API key (Brevo -> SMTP & API -> API keys) and a verified sender address.
# BREVO_API_KEY=
# MAIL_FROM=
# Sender name, default "University Assistant".
# MAIL_FROM_NAME=
# Shared secret for the daily sweep GET /api/cron/email-jobs (Vercel Cron sends it as a Bearer token).
# Unset: the route answers 503. Generate one with: openssl rand -base64 32
# CRON_SECRET=
